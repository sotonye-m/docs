# Mintlify automatically ignores these files and directories:
# .git, .github, .claude, .agents, .idea, node_modules,
# README.md, LICENSE.md, CHANGELOG.md, CONTRIBUTING.md

# Draft content
drafts/
*.draft.mdx

# Internal AI knowledge base source files (not documentation pages)
ai-knowledge-base/

# Record of menus hidden from navigation (not a docs page)
nav-records/

# Mintlify agent workflows (not documentation pages)
.mintlify/
